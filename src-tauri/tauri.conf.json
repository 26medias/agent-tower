{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Agent Tower",
    "version": "0.1.51",
    "identifier": "dev.agenttower.app",
    "build": {
        "beforeDevCommand": "pnpm --dir ui dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "pnpm --dir ui build",
        "frontendDist": "../ui/build"
    },
    "app": {
        "windows": [
            {
                "title": "Agent Tower",
                "width": 1200,
                "height": 800
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ]
    }
}
