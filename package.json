{
    "name": "agent-tower",
    "private": true,
    "scripts": {
        "tauri": "ui/node_modules/.bin/tauri",
        "setup": "pnpm --dir ui install",
        "build": "pnpm --dir ui build && cargo build --workspace --features tauri/custom-protocol",
        "start": "pnpm run build && target/debug/agent-tower"
    }
}
